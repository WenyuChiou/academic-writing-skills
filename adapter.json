        "default": false
      },
      "success_exit_code": 0
    },
    "candidate": {
      "script": "skills/academic-writing-skills/scripts/audit_candidate_text.py",
      "arguments": {
        "positional": [
          "state",
          "candidate"
        ],
        "options": [
          "--label LABEL",
          "--json"
        ]
      },
      "json_output": {
        "supported": true,
        "flag": "--json",
        "default": false
      },
      "success_exit_code": 0
    },
    "docx": {
      "script": "skills/academic-writing-skills/scripts/audit_docx_structure.py",
      "arguments": {
        "positional": [
          "docx [docx ...]"
        ],
        "options": [
          "--require-clean",
          "--require-valid-comments",
          "--json"
        ]
      },
      "json_output": {
        "supported": true,
        "flag": "--json",
        "default": false
      },
      "success_exit_code": 0
    },
    "regression": {
      "script": "skills/academic-writing-skills/scripts/run_regression_tests.py",
      "arguments": {
        "positional": [],
        "options": []
      },
      "json_output": {
        "supported": true,
        "flag": null,
        "default": true
      },
      "success_exit_code": 0
    }
  },
