# Public adapter hashes bind exact bytes across Windows and Unix checkouts.
/.gitattributes text eol=lf
/CHANGELOG.md text eol=lf
/README*.md text eol=lf
/skills/** text eol=lf
/skills/**/*.[pP][nN][gG] -text
/skills/**/*.[jJ][pP][gG] -text
/docs/images/**/*.[pP][nN][gG] -text
/docs/*.md text eol=lf
/.claude-plugin/*.json text eol=lf
/adapter.json text eol=lf
/locales/*.json text eol=lf
/LICENSE text eol=lf
/scripts/*.py text eol=lf
/tests/*.py text eol=lf
